# Скопируй этот файл в .env и заполни своими значениями

# Получи у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# Получи свой chat_id через @userinfobot или https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# RPC-адреса (публичные, бесплатные)
BASE_RPC_URL=https://mainnet.base.org
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# GeckoTerminal network slug (подтверждено: обе сети реально отдают new_pools)
GECKOTERMINAL_BASE_NETWORK=base
GECKOTERMINAL_ROBINHOOD_NETWORK=robinhood

# Официальный Uniswap V3 factory на Robinhood Chain (chainId 4663), подтверждено
# через developers.uniswap.org и перепроверено на robinhoodchain.blockscout.com.
# Discovery сейчас идёт через GeckoTerminal, это про запас для будущего on-chain fallback.
ROBINHOOD_V2_FACTORY=
ROBINHOOD_V3_FACTORY=0x1f7d7550b1b028f7571e69a784071f0205fd2efa

# WETH, USDG на Robinhood Chain (docs.robinhood.com/chain/contracts) — чтобы не скорить
# котируемую сторону пары как будто это новый мем-токен
ROBINHOOD_KNOWN_QUOTE_TOKENS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73,0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# Пороги
MIN_LIQUIDITY_USD=50000
DISCOVERY_POLL_SECONDS=45
WATCHLIST_POLL_SECONDS=120
PUMP_THRESHOLD_PCT=50
DUMP_THRESHOLD_PCT=30
LIQUIDITY_DROP_THRESHOLD_PCT=50
ALERT_COOLDOWN_SECONDS=3600

DB_PATH=meme_scout.sqlite3
